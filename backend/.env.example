# Copy to .env and fill in actual values. Never commit .env.

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL
# Local testing against Railway Postgres: copy the "Postgres Connection URL"
# from Railway -> your Postgres plugin -> Connect tab.
# On Railway itself, reference the plugin variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:port/database

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Resend (email sending)
RESEND_API_KEY=re_your_resend_api_key_here

# Server
PORT=3001
NODE_ENV=development
